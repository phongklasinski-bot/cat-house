.resource-bar {
  display: flex;
  gap: 14rpx;
  align-items: center;
}

.resource-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 126rpx;
  height: 58rpx;
  box-sizing: border-box;
  padding: 0 18rpx;
  border: 3rpx solid #6d4a2e;
  border-radius: 30rpx;
  color: #5a3d24;
  font-size: 26rpx;
  font-weight: 700;
  background: #fffdf6;
}

.icon {
  font-size: 28rpx;
}
