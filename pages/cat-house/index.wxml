<view class="safe-page build-page">
  <view class="top-row">
    <view>
      <text class="page-title">猫屋建设</text>
      <text class="level-name">Lv.{{saveData.house.level}} {{currentLevelName}}</text>
    </view>
    <resource-bar coins="{{saveData.player.coins}}" fish-snacks="{{saveData.player.fishSnacks}}" stamina="{{saveData.player.stamina}}" />
  </view>

  <view class="house-room soft-panel">
    <view class="room-window"></view>
    <view class="room-cat">🐈</view>
    <view class="furniture-stage">
      <block wx:for="{{purchasedFurniture}}" wx:key="id">
        <view class="placed-item">
          <text class="placed-icon">{{item.icon}}</text>
          <text class="placed-name">{{item.name}}</text>
        </view>
      </block>
    </view>
  </view>

  <view class="section-heading">
    <text>已购买家具</text>
    <button class="shop-button" bindtap="openShop">家具商店</button>
  </view>

  <view wx:if="{{purchasedFurniture.length === 0}}" class="empty-state">
    <text class="empty-icon">🏠</text>
    <text class="empty-title">猫屋还是空空的</text>
    <text class="empty-copy">去家具商店为橘小豆添置第一件家具。</text>
  </view>

  <view wx:else class="furniture-list">
    <block wx:for="{{purchasedFurniture}}" wx:key="id">
      <view class="furniture-row">
        <text class="furniture-icon">{{item.icon}}</text>
        <view class="furniture-copy">
          <text class="furniture-name">{{item.name}}</text>
          <text class="furniture-desc">{{item.description}}</text>
        </view>
        <text class="owned-label">已拥有</text>
      </view>
    </block>
  </view>
</view>
