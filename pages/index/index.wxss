.home-page {
  background: linear-gradient(180deg, #fff4d8 0%, #fffaf0 42%, #f1f9ed 100%);
}

.top-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.eyebrow,
.title {
  display: block;
}

.eyebrow {
  color: #a87b36;
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 0;
  text-transform: uppercase;
}

.title {
  margin-top: 8rpx;
  color: #4b3621;
  font-size: 46rpx;
  font-weight: 900;
}

.house-scene {
  position: relative;
  height: 430rpx;
  margin-top: 28rpx;
  overflow: hidden;
  background: linear-gradient(180deg, #fff6cf 0%, #f7deb0 62%, #bde4b1 63%, #a7d695 100%);
}

.window {
  position: absolute;
  top: 46rpx;
  right: 52rpx;
  width: 150rpx;
  height: 128rpx;
  border: 8rpx solid #6d4a2e;
  border-radius: 28rpx;
  background: #bce9ff;
}

.home-furniture {
  position: absolute;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 86rpx;
  min-height: 72rpx;
  box-sizing: border-box;
  padding: 7rpx 10rpx;
  border: 3rpx solid rgba(109, 74, 46, 0.45);
  border-radius: 16rpx;
  background: rgba(255, 253, 246, 0.78);
}

.home-furniture-icon {
  font-size: 43rpx;
}

.home-furniture-name {
  margin-top: 2rpx;
  color: #5a3d24;
  font-size: 18rpx;
  font-weight: 800;
}

.home-furniture-cat_bed {
  left: 28rpx;
  bottom: 18rpx;
}

.home-furniture-scratching_board {
  left: 244rpx;
  bottom: 22rpx;
}

.home-furniture-house_window {
  top: 50rpx;
  right: 82rpx;
}

.home-furniture-cat_tree {
  right: 24rpx;
  bottom: 18rpx;
}

.cat-stage {
  position: absolute;
  left: 70rpx;
  bottom: 82rpx;
  z-index: 3;
  width: 240rpx;
  height: 210rpx;
}

.cat-shadow {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 0;
  height: 34rpx;
  border-radius: 50%;
  background: rgba(83, 56, 30, 0.2);
}

.cat-body {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 18rpx;
  font-size: 150rpx;
  text-align: center;
}

.speech {
  position: absolute;
  right: 34rpx;
  bottom: 118rpx;
  z-index: 4;
  width: 330rpx;
  box-sizing: border-box;
  padding: 22rpx;
  border: 4rpx solid #6d4a2e;
  border-radius: 24rpx;
  color: #5a3d24;
  background: #fffdf6;
  font-size: 25rpx;
  line-height: 1.45;
}

.section-title {
  margin: 34rpx 0 18rpx;
  color: #4b3621;
  font-size: 34rpx;
  font-weight: 900;
}

.entry-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.action-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-top: 28rpx;
}

.nav-tile {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 136rpx;
  border: 4rpx solid #6d4a2e;
  border-radius: 22rpx;
  color: #4b3621;
  font-size: 24rpx;
  font-weight: 800;
  background: #fffdf6;
  box-shadow: 0 8rpx 0 rgba(109, 74, 46, 0.16);
}
