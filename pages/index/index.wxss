.home-page {
  background: linear-gradient(180deg, #fff4d8 0%, #fffaf0 42%, #f1f9ed 100%);
}

.top-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.eyebrow,
.title {
  display: block;
}

.eyebrow {
  color: #a87b36;
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 0;
  text-transform: uppercase;
}

.title {
  margin-top: 8rpx;
  color: #4b3621;
  font-size: 46rpx;
  font-weight: 900;
}

.house-scene {
  position: relative;
  height: 430rpx;
  margin-top: 28rpx;
  overflow: hidden;
  background: linear-gradient(180deg, #fff6cf 0%, #f7deb0 62%, #bde4b1 63%, #a7d695 100%);
}

.window {
  position: absolute;
  top: 46rpx;
  right: 52rpx;
  width: 150rpx;
  height: 128rpx;
  border: 8rpx solid #6d4a2e;
  border-radius: 28rpx;
  background: #bce9ff;
}

.cat-stage {
  position: absolute;
  left: 34rpx;
  bottom: 40rpx;
  z-index: 2;
  width: 220rpx;
  height: 190rpx;
}

.cat-shadow {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 0;
  height: 34rpx;
  border-radius: 50%;
  background: rgba(83, 56, 30, 0.2);
}

.cat-body {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 18rpx;
  font-size: 138rpx;
  text-align: center;
}

.furniture-stage {
  position: absolute;
  right: 28rpx;
  bottom: 24rpx;
  z-index: 4;
  display: grid;
  grid-template-columns: repeat(2, 130rpx);
  gap: 14rpx;
}

.placed-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 112rpx;
  border: 3rpx solid rgba(109, 74, 46, 0.5);
  border-radius: 18rpx;
  background: rgba(255, 253, 246, 0.88);
}

.placed-icon {
  font-size: 46rpx;
}

.placed-name {
  margin-top: 4rpx;
  color: #5a3d24;
  font-size: 20rpx;
  font-weight: 700;
}

.speech {
  position: absolute;
  top: 22rpx;
  left: 22rpx;
  z-index: 5;
  max-width: 340rpx;
  box-sizing: border-box;
  padding: 18rpx 22rpx;
  border: 4rpx solid #6d4a2e;
  border-radius: 22rpx;
  color: #5a3d24;
  background: #fffdf6;
  font-size: 24rpx;
  line-height: 1.4;
  box-shadow: 0 7rpx 0 rgba(109, 74, 46, 0.14);
}

.section-title {
  margin: 34rpx 0 18rpx;
  color: #4b3621;
  font-size: 34rpx;
  font-weight: 900;
}

.entry-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.action-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-top: 28rpx;
}

.nav-tile {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 136rpx;
  border: 4rpx solid #6d4a2e;
  border-radius: 22rpx;
  color: #4b3621;
  font-size: 24rpx;
  font-weight: 800;
  background: #fffdf6;
  box-shadow: 0 8rpx 0 rgba(109, 74, 46, 0.16);
}
