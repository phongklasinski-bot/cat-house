.game-entry {
  display: flex;
  align-items: center;
  width: 100%;
  height: 128rpx;
  box-sizing: border-box;
  padding: 0 24rpx;
  border: 4rpx solid #6d4a2e;
  border-radius: 24rpx;
  background: #fffdf6;
  box-shadow: 0 8rpx 0 rgba(109, 74, 46, 0.16);
  text-align: left;
}

.entry-icon {
  width: 72rpx;
  font-size: 46rpx;
}

.entry-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 10rpx;
}

.entry-title {
  color: #4b3621;
  font-size: 30rpx;
  font-weight: 800;
}

.entry-subtitle {
  color: #8c6a46;
  font-size: 24rpx;
}

.entry-arrow {
  color: #b87924;
  font-size: 52rpx;
  font-weight: 700;
}

.is-disabled {
  opacity: 0.55;
}
